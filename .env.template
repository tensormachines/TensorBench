# Copy to .env and fill in. .env is gitignored.

# Hugging Face token.
HF_TOKEN=

# AWS credentials, only for scripts/pull_weights.sh and push_weights.sh.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# BMC credentials. Leave blank on nodes whose BMC answers over local IPMI.
BMC_HOST=
BMC_USER=
BMC_PASS=

# Ownership cost per GPU per hour.
SCORE_OH=
# Reserved power capacity cost per GPU per hour.
SCORE_RH=
# Electricity cost per kWh.
SCORE_CE=
# Expected utilization, greater than 0 and at most 1.
SCORE_UZ=

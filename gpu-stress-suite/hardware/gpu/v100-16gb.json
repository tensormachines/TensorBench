{
  "description": "16GB V100 boards",
  "match": {
    "pci_device_id": ["0x1DB110DE"],
    "memory_mib": { "min": 15500, "max": 16500 }
  },
  "vram": {
    "reserve_fraction": 0.8
  },
  "workloads": {
    "workload1_tensor_compute": {
      "matrix_size": 8192,
      "batch_size": 4,
      "precision": "fp16"
    },
    "workload2_conv_compute": {
      "batch_sizes": [64, 32, 16],
      "image_size": 224
    },
    "workload3_random_access_memory": {
      "working_set_gb": 1.5
    },
    "workload4_fft_compute": {
      "batch_sizes": [8, 4, 2, 1],
      "grid_sizes": [2048, 1536, 1024]
    },
    "workload5_memory_bandwidth": {
      "buffer_gb": 4.0
    },
    "workload6_multigpu_nccl": {
      "tensor_mb": 512
    },
    "workload_1C": {
      "batch": 8,
      "seq": 512
    },
    "workload_2A": {
      "batch": 4,
      "seq": 1024
    },
    "workload_2B": {
      "_note": "Llama-3.2-3B-Instruct FP16 (Meta-official, same Llama-3 family). An 8B FP16 base is 16 GB on its own so it physically cannot fit a 16 GB V100; 3B at batch 16 seq 256 fits with ~4 GB headroom. grad_accum 8 gives effective batch 128; 200 steps.",
      "base_model": "meta-llama/Llama-3.2-3B-Instruct",
      "batch": 16,
      "seq": 256,
      "grad_accum": 8,
      "steps": 200
    },
    "workload_3A": {
      "batch": 1,
      "seq": 2048
    }
  }
}
